VITE_API_URL=http://localhost:5000
VITE_GOOGLE_CLIENT_ID=<google-web-client-id>.apps.googleusercontent.com
# local, staging, preview, or production. Provider configuration must bind
# each value to an API and Google client from the same environment.
VITE_DEPLOYMENT_ENV=local
