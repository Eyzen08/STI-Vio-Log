PORT=5000
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-characters
SESSION_HASH_KEY=replace-with-an-independent-random-secret-at-least-32-characters
CSRF_SIGNING_KEY=replace-with-an-independent-random-secret-at-least-32-characters
OTP_HASH_KEY=replace-with-an-independent-random-secret-at-least-32-characters
AUTH_THROTTLE_KEY=replace-with-an-independent-random-secret-at-least-32-characters
MFA_RECOVERY_KEY=replace-with-an-independent-random-secret-at-least-32-characters
MFA_ENCRYPTION_KEY=replace-with-base64-of-exactly-32-random-bytes
CERTIFICATE_SIGNING_KEY=replace-with-an-independent-random-secret-at-least-32-characters
FRONTEND_URL=http://localhost:3000,http://localhost:5173
GOOGLE_CLIENT_ID=<google-web-client-id>.apps.googleusercontent.com
# Recommended for production hosts that block outbound SMTP ports.
BREVO_API_KEY=replace-with-a-brevo-api-key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=STI Vio-Log
EMAIL_TIMEOUT_MS=10000

# Optional SMTP fallback for local development or paid hosts.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=mailer@example.com
SMTP_PASS=replace-with-an-smtp-app-password
MAIL_FROM=STI Vio-Log <mailer@example.com>
SMTP_TIMEOUT_MS=10000

DB_HOST=localhost
DB_PORT=5432
DB_NAME=sti_vio_log
DB_USER=postgres
DB_PASSWORD=your_password
DATABASE_URL=
# Owner/direct or session-pooler URL used only by the migration command.
MIGRATION_DATABASE_URL=
DB_SSL=disable
# PEM certificate authority for verified production database TLS. Literal
# newlines or escaped \\n sequences are accepted.
DB_SSL_CA=
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=10000
DB_STATEMENT_TIMEOUT_MS=15000
TRUST_PROXY_HOPS=1
# Must be an absolute private path outside this repository and OneDrive.
BACKUP_DIR=
BACKUP_ENCRYPTION_KEY=replace-with-base64-of-exactly-32-random-bytes
NODE_ENV=development
ALLOW_LEGACY_SYSTEM_ACCOUNT_ACTIONS=false
SYSTEM_SUPER_ADMIN_PHASE3_ENABLED=false
