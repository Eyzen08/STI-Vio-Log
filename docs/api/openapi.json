{
  "openapi": "3.1.0",
  "info": { "title": "STI Vio-Log API", "version": "1.3.0", "description": "Stable opaque-cookie and CSRF contract. Roles: DISCIPLINE_ADMIN, DISCIPLINE_OFFICE, DEPARTMENT_HEAD, STUDENT. All roles use the unified /login UI." },
  "servers": [{ "url": "/api" }],
  "components": {
    "securitySchemes": {
      "sessionCookie": { "type": "apiKey", "in": "cookie", "name": "sti_session", "description": "Opaque, server-hashed browser session. Mutation operations also require X-CSRF-Token." },
      "csrfHeader": { "type": "apiKey", "in": "header", "name": "X-CSRF-Token" }
    },
    "schemas": {
      "ErrorResponse": { "type": "object", "required": ["success", "message"], "properties": { "success": { "const": false }, "message": { "type": "string" }, "error": { "type": "object", "properties": { "code": { "type": "string", "examples": ["VALIDATION_ERROR"] }, "message": { "type": "string" } } } } },
      "PaginationMetadata": { "type": "object", "properties": { "page": { "type": "integer" }, "limit": { "type": "integer" }, "returned": { "type": "integer" } } },
      "StudentSummary": { "type": "object", "properties": { "id": { "type": "integer" }, "student_number": { "type": "string", "minLength": 1, "maxLength": 50, "pattern": "^[^\\s]+$" }, "first_name": { "type": "string" }, "last_name": { "type": "string" } } },
      "Violation": { "type": "object", "properties": { "id": { "type": "integer" }, "student_id": { "type": "integer" }, "student_name": { "type": "string" }, "student_number": { "type": "string" }, "incident_date": { "type": "string", "format": "date" }, "incident_time": { "type": ["string", "null"], "format": "time" }, "status": { "enum": ["OPEN", "COMPLETE", "CLEAR", "INVALID_CANCEL"] }, "required_service_hours": { "type": "number" }, "completed_service_hours": { "type": "number" }, "offense_indicator_level": { "enum": ["NEUTRAL", "MINOR_1", "MINOR_2", "MAJOR_LEVEL", "GRAVE"] }, "major_level_review_required": { "type": "boolean" } } },
      "OffenseStatus": { "type": "object", "description": "Derived from retained qualifying violation history; source records are never rewritten.", "properties": { "policy_scope": { "const": "ALL_HISTORY" }, "minor_count": { "type": "integer" }, "major_count": { "type": "integer" }, "grave_count": { "type": "integer" }, "indicator_level": { "enum": ["NEUTRAL", "MINOR_1", "MINOR_2", "MAJOR_LEVEL", "GRAVE"] }, "major_level_review_required": { "type": "boolean" } } },
      "ViolationAction": { "type": "object", "properties": { "action": { "enum": ["COMPLETE", "CLEAR", "INVALID_CANCEL", "REOPEN"] }, "reason": { "type": ["string", "null"] }, "created_at": { "type": "string", "format": "date-time" } } },
      "CommunityServiceAssignment": { "type": "object", "properties": { "id": { "type": "integer" }, "department_id": { "type": ["integer", "null"] }, "department_head_id": { "type": ["integer", "null"] }, "required_hours": { "type": "number" }, "completed_hours": { "type": "number", "description": "Derived compatibility cache; session minutes are authoritative." }, "remaining_hours": { "type": "number" }, "status": { "type": "string" } } },
      "AttendanceOutcome": { "type": "string", "enum": ["TODAYS_SERVICE_COMPLETED", "LEFT_EARLY", "SERVICE_COMPLETED"], "description": "Required at time-out and validated against the server-calculated remaining requirement." },
      "DtrSession": { "type": "object", "properties": { "id": { "type": "integer" }, "assignment_id": { "type": "integer" }, "time_in": { "type": "string", "format": "date-time" }, "time_out": { "type": ["string", "null"], "format": "date-time" }, "worked_minutes": { "type": ["integer", "null"] }, "credited_minutes": { "type": ["integer", "null"] }, "attendance_outcome": { "oneOf": [{ "$ref": "#/components/schemas/AttendanceOutcome" }, { "type": "string", "enum": ["SATISFACTORY", "NEEDS_FOLLOW_UP", "INCIDENT_REPORTED"], "description": "Legacy historical value" }, { "type": "null" }] }, "elapsed_seconds": { "type": ["integer", "null"] }, "timer_limit_seconds": { "type": "integer" }, "limit_reached": { "type": "boolean" }, "status": { "enum": ["ACTIVE", "COMPLETED"] } } },
      "ServiceProgress": { "type": "object", "properties": { "required_minutes": { "type": "integer" }, "credited_minutes": { "type": "integer" }, "remaining_minutes": { "type": "integer" } } },
      "Clearance": { "type": "object", "properties": { "id": { "type": "integer" }, "status": { "enum": ["ELIGIBLE", "NOT_ELIGIBLE", "PENDING", "CLEARED"] }, "has_active_violation": { "type": "boolean" }, "has_pending_service": { "type": "boolean" } } },
      "AuditEntry": { "type": "object", "properties": { "id": { "type": "integer" }, "user_id": { "type": ["integer", "null"] }, "action": { "type": "string" }, "table_name": { "type": ["string", "null"] }, "record_id": { "type": ["integer", "null"] }, "created_at": { "type": "string", "format": "date-time" } } },
      "SystemComponent": { "type": "object", "description": "Sanitized health metadata; configuration values, hosts, and credentials are never returned.", "properties": { "provider": { "type": "string" }, "technology": { "type": "string" }, "icon": { "type": "string" }, "status": { "type": "string" }, "latency_ms": { "type": ["number", "null"] }, "remediation": { "type": ["string", "null"] } } },
      "SystemAccountTarget": { "type": "object", "properties": { "id": { "type": "integer" }, "username": { "type": "string" }, "role": { "enum": ["DISCIPLINE_ADMIN", "DISCIPLINE_OFFICE", "DEPARTMENT_HEAD", "STUDENT"] }, "is_active": { "type": "boolean" }, "must_change_password": { "type": "boolean" }, "session_version": { "type": "integer" }, "is_self": { "type": "boolean" }, "can_lock": { "type": "boolean" }, "can_recover": { "type": "boolean" }, "lock_restriction_code": { "type": ["string", "null"] }, "recovery_restriction_code": { "type": ["string", "null"] } } }
    },
    "responses": { "BadRequest": { "description": "Validation or business-rule failure", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }, "Unauthorized": { "description": "Authentication required" }, "Forbidden": { "description": "Role or department scope denied" }, "NotFound": { "description": "Resource not found or not visible" }, "Conflict": { "description": "Concurrency or uniqueness conflict" } }
  },
  "security": [{ "sessionCookie": [] }],
  "paths": {
    "/login": { "post": { "security": [], "tags": ["Auth"], "summary": "Authenticate with username and password", "description": "Sets an HttpOnly session cookie for standard users, or a short-lived pre-authentication cookie for required privileged MFA.", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["username", "password"], "properties": { "username": { "type": "string" }, "password": { "type": "string", "format": "password", "minLength": 12, "maxLength": 128 } } } } }, "responses": { "200": { "description": "Session cookie set and current user returned" }, "202": { "description": "MFA enrollment or verification required; no normal session issued" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "429": { "description": "IP or account rate limit" } } } } },
    "/auth/session": { "get": { "tags": ["Auth"], "summary": "Return the current session user", "responses": { "200": { "description": "Current user" }, "401": { "$ref": "#/components/responses/Unauthorized" } } } },
    "/auth/csrf": { "get": { "tags": ["Auth"], "summary": "Rotate and return the session-bound CSRF token", "responses": { "200": { "description": "CSRF token" }, "401": { "$ref": "#/components/responses/Unauthorized" } } } },
    "/auth/logout": { "post": { "security": [{ "sessionCookie": [], "csrfHeader": [] }], "tags": ["Auth"], "summary": "Revoke the current session and clear cookies", "responses": { "200": { "description": "Session revoked" } } } },
    "/auth/mfa/setup/start": { "post": { "security": [], "tags": ["Auth"], "summary": "Start mandatory privileged TOTP enrollment", "responses": { "200": { "description": "TOTP secret and provisioning URI" }, "401": { "$ref": "#/components/responses/Unauthorized" } } } },
    "/auth/mfa/setup/confirm": { "post": { "security": [], "tags": ["Auth"], "summary": "Confirm TOTP enrollment and issue one-time recovery codes", "responses": { "200": { "description": "Session established; recovery codes returned once" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "429": { "description": "IP or account rate limit" } } } },
    "/auth/mfa/verify": { "post": { "security": [], "tags": ["Auth"], "summary": "Complete privileged login with TOTP", "responses": { "200": { "description": "Session established" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "429": { "description": "IP or account rate limit" } } } },
    "/auth/mfa/recovery": { "post": { "security": [], "tags": ["Auth"], "summary": "Complete privileged login with a one-time recovery code", "responses": { "200": { "description": "Session established and recovery code consumed" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "429": { "description": "IP or account rate limit" } } } },
    "/auth/student/password/forgot": { "post": { "security": [], "tags": ["Auth"], "summary": "Request a Student password-reset OTP using a non-enumerating response", "responses": { "200": { "description": "Generic response" }, "429": { "description": "Rate limited" } } } },
    "/auth/student/password/verify": { "post": { "security": [], "tags": ["Auth"], "summary": "Verify reset OTP and issue a short-lived reset authorization", "responses": { "200": { "description": "Reset authorization issued" }, "400": { "$ref": "#/components/responses/BadRequest" } } } },
    "/auth/student/password/reset": { "post": { "security": [], "tags": ["Auth"], "summary": "Set a new Student password using reset authorization", "responses": { "200": { "description": "Password reset" }, "401": { "$ref": "#/components/responses/Unauthorized" } } } },
    "/auth/google/link": { "post": { "security": [], "tags": ["Auth"], "summary": "Link Google to an existing active student account", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["credential", "student_number", "first_name", "last_name"], "properties": { "credential": { "type": "string" }, "student_number": { "type": "string", "minLength": 1, "maxLength": 50, "pattern": "^[^\\s]+$" }, "first_name": { "type": "string" }, "last_name": { "type": "string" } } } } } }, "responses": { "200": { "description": "Session cookie set and linked existing student user returned" }, "409": { "$ref": "#/components/responses/Conflict" }, "429": { "description": "Rate limited" }, "503": { "description": "Google authentication unavailable" } } } },
    "/auth/google/login": { "post": { "security": [], "tags": ["Auth"], "summary": "Authenticate an already-linked student Google identity", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["credential"], "properties": { "credential": { "type": "string" } } } } } }, "responses": { "200": { "description": "Session cookie set and current student user returned" }, "401": { "$ref": "#/components/responses/Unauthorized" }, "429": { "description": "IP or account rate limit" }, "503": { "description": "Google authentication unavailable" } } } },
    "/account/student-onboarding/google-email/request": { "post": { "security": [{ "sessionCookie": [], "csrfHeader": [] }], "tags": ["Auth"], "summary": "Send a Student onboarding OTP to a Google-account email", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["email"], "properties": { "email": { "type": "string", "format": "email", "maxLength": 255 } } } } } }, "responses": { "200": { "description": "OTP sent and Google onboarding stage advanced to OTP" }, "429": { "description": "OTP resend limited" } } } },
    "/account/student-onboarding/google-email/verify": { "post": { "security": [{ "sessionCookie": [], "csrfHeader": [] }], "tags": ["Auth"], "summary": "Confirm the Student onboarding Google-account email OTP", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["code"], "properties": { "code": { "type": "string", "pattern": "^[0-9]{6}$" } } } } } }, "responses": { "200": { "description": "Email confirmed and Google onboarding stage advanced to OAUTH" }, "400": { "$ref": "#/components/responses/BadRequest" }, "429": { "description": "OTP attempts exceeded" } } } },
    "/account/student-onboarding/google-link": { "post": { "security": [{ "sessionCookie": [], "csrfHeader": [] }], "tags": ["Auth"], "summary": "Bind the OTP-confirmed Google account during mandatory Student onboarding", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["credential"], "properties": { "credential": { "type": "string" } } } } } }, "responses": { "200": { "description": "Matching Google identity linked and confirmed email established as recovery address" }, "409": { "$ref": "#/components/responses/Conflict" } } } },
    "/account/student-onboarding/profile": { "post": { "security": [{ "sessionCookie": [], "csrfHeader": [] }], "tags": ["Students"], "summary": "Complete mandatory Student academic, contact, and guardian onboarding", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["program", "section", "year_level", "phone_number", "guardian_name", "guardian_relationship", "guardian_phone_number"], "properties": { "program": { "type": "string" }, "section": { "type": "string", "maxLength": 100 }, "year_level": { "type": "integer", "minimum": 1, "maximum": 8 }, "phone_number": { "type": "string" }, "guardian_name": { "type": "string", "maxLength": 200 }, "guardian_relationship": { "type": "string", "maxLength": 100 }, "guardian_phone_number": { "type": "string" } } } } } }, "responses": { "200": { "description": "Academic, contact, guardian, and completion data saved transactionally; normal Student portal access enabled" }, "409": { "$ref": "#/components/responses/Conflict" } } } },
    "/google-registrations": { "get": { "tags": ["Google Registrations"], "summary": "List Discipline Office student-record requests (DISCIPLINE_ADMIN, DISCIPLINE_OFFICE)", "parameters": [{ "name": "status", "in": "query", "schema": { "enum": ["PENDING", "APPROVED", "REJECTED"] } }, { "name": "limit", "in": "query", "schema": { "type": "integer", "maximum": 100 } }], "responses": { "200": { "description": "Non-sensitive registration review queue" }, "403": { "$ref": "#/components/responses/Forbidden" } } } },
    "/google-registrations/{id}/approve": { "post": { "tags": ["Google Registrations"], "summary": "Approve the Discipline Office student record and atomically create the student account", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["reason"], "properties": { "reason": { "type": "string", "maxLength": 1000 } } } } } }, "responses": { "200": { "description": "Student record approved and account created" }, "409": { "$ref": "#/components/responses/Conflict" } } } },
    "/google-registrations/{id}/reject": { "post": { "tags": ["Google Registrations"], "summary": "Reject a student-record request while preserving review history", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["reason"], "properties": { "reason": { "type": "string", "maxLength": 1000 } } } } } }, "responses": { "200": { "description": "Rejected" }, "409": { "$ref": "#/components/responses/Conflict" } } } },
    "/health": { "get": { "security": [], "tags": ["System"], "summary": "Application and database health", "responses": { "200": { "description": "Healthy" }, "503": { "description": "Database unavailable" } } } },
    "/students": { "get": { "tags": ["Students"], "summary": "List students (DISCIPLINE_ADMIN, DISCIPLINE_OFFICE)", "responses": { "200": { "description": "Student list" } } }, "post": { "tags": ["Students"], "summary": "Create a legal-identity-only student account and return one-time temporary credentials (DISCIPLINE_ADMIN, DISCIPLINE_OFFICE)", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["student_number", "first_name", "last_name"], "properties": { "student_number": { "type": "string", "minLength": 1, "maxLength": 50, "pattern": "^[^\\s]+$" }, "first_name": { "type": "string" }, "middle_name": { "type": "string" }, "last_name": { "type": "string" }, "suffix": { "type": "string" } } } } } }, "responses": { "201": { "description": "Student created with a server-generated QR value, account.username, temporary_password, password_change_required, onboarding_required, and onboarding_step" }, "400": { "$ref": "#/components/responses/BadRequest" } } } },
    "/students/{id}": { "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "get": { "tags": ["Students"], "summary": "Read student" }, "put": { "tags": ["Students"], "summary": "Update whitelisted student fields" }, "delete": { "tags": ["Students"], "summary": "Delete student" } },
    "/students/me": { "get": { "tags": ["Students"], "summary": "Read authenticated student's profile" } },
    "/students/me/violations": { "get": { "tags": ["Students"], "summary": "Read own violations" } },
    "/students/me/notifications": { "get": { "tags": ["Notifications"], "summary": "Read own event notifications", "parameters": [{ "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1 } }, { "name": "limit", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100 } }] } },
    "/students/me/notifications/{id}/read": { "patch": { "tags": ["Notifications"], "summary": "Mark an owned notification as read", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "minimum": 1 } }], "requestBody": { "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false } } } }, "responses": { "200": { "description": "Notification marked read" }, "404": { "$ref": "#/components/responses/NotFound" } } } },
    "/students/me/community-service": { "get": { "tags": ["Community Service"], "summary": "Read own assignments" } },
    "/students/me/community-service/dtr": { "get": { "tags": ["Community Service"], "summary": "Read own DTR and progress", "parameters": [{ "name": "from", "in": "query", "schema": { "type": "string", "format": "date" } }, { "name": "to", "in": "query", "schema": { "type": "string", "format": "date" } }] } },
    "/students/me/clearance": { "get": { "tags": ["Clearance"], "summary": "Read own clearance" } },
    "/student/clearance/certificate": { "get": { "tags": ["Clearance"], "summary": "Read own currently valid good-standing certificate", "responses": { "200": { "description": "Server-authorized certificate" }, "409": { "$ref": "#/components/responses/Conflict" } } } },
    "/certificates/clearance/{code}": { "get": { "security": [], "tags": ["Clearance"], "summary": "Verify a signed clearance certificate", "parameters": [{ "name": "code", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "Certificate remains valid" }, "404": { "$ref": "#/components/responses/NotFound" } } } },
    "/parent-contact/{studentId}": { "parameters": [{ "name": "studentId", "in": "path", "required": true, "schema": { "type": "integer" } }], "get": { "tags": ["Parent Contact"], "summary": "Read authorized guardian details and contact history", "responses": { "200": { "description": "Scoped guardian details and append-only history" }, "404": { "$ref": "#/components/responses/NotFound" } } }, "post": { "tags": ["Parent Contact"], "summary": "Record an authorized parent or guardian contact attempt", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "additionalProperties": false, "required": ["guardian_id", "contact_method", "outcome"], "properties": { "guardian_id": { "type": "integer" }, "contact_method": { "enum": ["CALL", "SMS", "IN_PERSON", "OTHER"] }, "outcome": { "enum": ["REACHED", "NO_ANSWER", "LEFT_MESSAGE", "FOLLOW_UP", "OTHER"] }, "notes": { "type": "string", "maxLength": 1000 } } } } } }, "responses": { "201": { "description": "Append-only contact record created" }, "404": { "$ref": "#/components/responses/NotFound" } } } },
    "/violations": { "get": { "tags": ["Violations"], "summary": "List violations (DISCIPLINE_ADMIN, DISCIPLINE_OFFICE)" }, "post": { "tags": ["Violations"], "summary": "Create violation and synchronized assignment" } },
    "/violations/{id}": { "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "get": { "tags": ["Violations"], "summary": "Read violation" }, "put": { "tags": ["Violations"], "summary": "Update metadata; lifecycle status forbidden" }, "delete": { "tags": ["Violations"], "summary": "Permanent deletion is rejected" } },
    "/violations/{id}/actions": { "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "get": { "tags": ["Violations"], "summary": "Read lifecycle history" }, "post": { "tags": ["Violations"], "summary": "Perform COMPLETE, CLEAR, INVALID_CANCEL, or REOPEN", "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ViolationAction" } } } } } },
    "/community-service": { "get": { "tags": ["Community Service"], "summary": "List assignments" }, "post": { "tags": ["Community Service"], "summary": "Create a department-routed assignment" } },
    "/community-service/assignment-options": { "get": { "tags": ["Community Service"], "summary": "List active department and Department Head destinations" } },
    "/community-service/{id}": { "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }], "get": { "tags": ["Community Service"], "summary": "Read assignment" }, "put": { "tags": ["Community Service"], "summary": "Update required hours only" }, "delete": { "tags": ["Community Service"], "summary": "Permanent deletion is rejected" } },
    "/community-service/attendance/time-in": { "post": { "tags": ["Community Service"], "summary": "Create ACTIVE session as authorized staff" } },
    "/community-service/attendance/time-out": { "post": { "tags": ["Community Service"], "summary": "Complete active session and credit minutes atomically", "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["assignment_id", "student_id", "attendance_outcome"], "properties": { "assignment_id": { "type": "integer" }, "student_id": { "type": "integer" }, "attendance_outcome": { "$ref": "#/components/schemas/AttendanceOutcome" }, "notes": { "type": "string", "maxLength": 500 }, "supervising_officer_id": { "type": "integer" } } } } } } } },
    "/community-service/{assignmentId}/sessions": { "get": { "tags": ["Community Service"], "summary": "Read authoritative sessions", "parameters": [{ "name": "assignmentId", "in": "path", "required": true, "schema": { "type": "integer" } }] } },
    "/reports/parent-contacts": { "get": { "tags": ["Reports"], "summary": "Export authorized parent-contact activity without guardian phone numbers" } },
    "/reports/clearance": { "get": { "tags": ["Reports"], "summary": "Export clearance records" } },
    "/reports/good-standing": { "get": { "tags": ["Reports"], "summary": "Export students with no current disciplinary blockers" } },
    "/messages/conversations": { "get": { "tags": ["Messages"], "summary": "List student or Discipline Office conversation summaries; Department Accounts receive 403", "responses": { "403": { "$ref": "#/components/responses/Forbidden" } } }, "post": { "tags": ["Messages"], "summary": "Start a student/Discipline Office conversation", "description": "Students submit only subject and message; recipient_department_id is unsupported. Authorized staff submit student_id, subject, and message. Department Accounts receive 403.", "requestBody": { "required": true, "content": { "application/json": { "schema": { "oneOf": [{ "type": "object", "additionalProperties": false, "required": ["subject", "message"], "properties": { "subject": { "type": "string", "maxLength": 200 }, "message": { "type": "string", "maxLength": 1000 } } }, { "type": "object", "additionalProperties": false, "required": ["student_id", "subject", "message"], "properties": { "student_id": { "type": "integer" }, "subject": { "type": "string", "maxLength": 200 }, "message": { "type": "string", "maxLength": 1000 } } }] } } } }, "responses": { "201": { "description": "Conversation created" }, "403": { "$ref": "#/components/responses/Forbidden" } } } },
    "/messages/unread-count": { "get": { "tags": ["Messages"], "summary": "Return the unread message total in authenticated scope" } },
    "/messages/recipients": { "get": { "tags": ["Messages"], "summary": "List role-scoped recipients available to the authenticated user" } },
    "/messages/conversations/{id}": { "get": { "tags": ["Messages"], "summary": "Read a paginated authorized append-only conversation" } },
    "/messages/conversations/{id}/messages": { "post": { "tags": ["Messages"], "summary": "Append a text reply" } },
    "/messages/conversations/{id}/read": { "patch": { "tags": ["Messages"], "summary": "Mark an authorized conversation read" } },
    "/messages/conversations/{id}/status": { "patch": { "tags": ["Messages"], "summary": "Open or close a conversation as Admin or Discipline Office" } },
    "/qr/scan": { "post": { "tags": ["QR"], "summary": "Resolve QR student and active assignment" } },
    "/qr/time-in": { "post": { "tags": ["QR"], "summary": "QR TIME_IN" } },
